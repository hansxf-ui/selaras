# Salin file ini jadi ".env.local" untuk development lokal (jangan di-commit ke GitHub)
# Untuk deploy, semua nilai ini dimasukkan lewat Environment Variables di dashboard Vercel

# Dari Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-kamu-di-sini

# Dari Supabase Dashboard -> Settings -> API -> service_role (RAHASIA, jangan pernah dipakai di frontend)
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini

# VAPID key untuk push notification (sudah digenerate, tinggal pakai)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BCKlUc-pswFGGE5w9veUTtPl3MSP3Om5C1OZtYef0QVIUnXmwzSp-isqQc6o8tktnSznUHyFhqsJLvkWfnfbpxc
VAPID_PRIVATE_KEY=qIPVe-emVHxHndae-7bw6Dcy-zrtWIQX89AvpgIB6Ng
